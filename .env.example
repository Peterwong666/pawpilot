# Copy to .env and fill in your keys.

# --- LLM providers (OpenAI-compatible) ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# https://bailian.console.aliyun.com/ (DashScope compatible-mode)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- Embedding / Rerank (SiliconFlow, OpenAI-compatible) ---
# https://siliconflow.cn (bge-m3 / bge-reranker have free tiers)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Database (docker/docker-compose.yml dev service) ---
DATABASE_URL=postgresql://pawpilot:pawpilot@localhost:5433/pawpilot

# --- RAG tuning ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
FINAL_TOP_K=6
RRF_K=60

# --- Agent guardrails ---
MAX_ITERATIONS=8
TOOL_TIMEOUT_SECONDS=60
